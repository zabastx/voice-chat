# ===== Domain =====
# DNS A records required for BOTH:  {DOMAIN}  and  livekit.{DOMAIN}  -> VPS IP
DOMAIN=chat.example.com

# ===== Database (Postgres) =====
# password for the bundled postgres service:  openssl rand -hex 32
POSTGRES_PASSWORD=
# connection string the app uses — paste the SAME password here (env_file values
# are taken literally, no ${} expansion); "postgres" is the compose service name
NUXT_DATABASE_URL=postgres://postgres:CHANGE_ME@postgres:5432/voicechat

# ===== Sessions =====
# random string, 32+ characters:  openssl rand -hex 32
NUXT_SESSION_PASSWORD=

# ===== LiveKit =====
# key name must stay "voicechat" (referenced in deploy/livekit.yaml webhook config)
NUXT_LIVEKIT_API_KEY=voicechat
# random secret, 32+ characters:  openssl rand -hex 32
NUXT_LIVEKIT_API_SECRET=
# public signaling URL for browsers (subdomain from above, wss://)
NUXT_PUBLIC_LIVEKIT_URL=wss://livekit.chat.example.com

# ===== Telegram notifications (optional) =====
# Delivered via the standalone telegram-relay/ service (hosted where Telegram is
# reachable). Leave RELAY_URL blank to disable the whole feature. The app itself
# never contacts api.telegram.org — see telegram-relay/README.md.
# Base URL of the relay service (no trailing slash)
NUXT_TELEGRAM_RELAY_URL=https://relay.example.com
# shared bearer secret; MUST equal the relay's RELAY_SECRET
NUXT_TELEGRAM_RELAY_SECRET=
# Bot @username (no @), used to build the t.me/<bot>?start=<token> deep link
NUXT_PUBLIC_TELEGRAM_BOT_USERNAME=

# ===== VK notifications (optional — see docs/adr/0011) =====
# VK is reached directly, with no relay: the app calls api.vk.ru and polls
# lp.vk.ru, both outbound. Callback (inbound) is the alternative, not the default.
# Callback only. Управление → Работа с API → Callback API →
# «Строка, которую должен вернуть сервер». It rotates;
# groups.getCallbackConfirmationCode returns the current value.
NUXT_VK_CONFIRMATION_CODE=
# «Секретный ключ» on the same screen — the only authentication of the caller,
# since the callback URL is not a secret. Must match exactly.
NUXT_VK_CALLBACK_SECRET=
# Sending: community access key (messages + photos + docs rights) and the
# numeric community id. Both unset = VK notifications disabled entirely.
NUXT_VK_TOKEN=
NUXT_VK_GROUP_ID=
NUXT_PUBLIC_VK_GROUP_ID=
# Inbound transport: 'longpoll' (default, outbound-only, no public URL needed)
# or 'callback'. Never run both — VK would deliver every event twice.
NUXT_VK_INBOUND=longpoll

# ===== S3-compatible storage (attachments) =====
# from your hosting provider's object storage page (S3 credentials, not Swift)
NUXT_S3_ENDPOINT=https://s3.example-provider.com
NUXT_S3_BUCKET=
NUXT_S3_REGION=ru-1
NUXT_S3_ACCESS_KEY_ID=
NUXT_S3_SECRET_ACCESS_KEY=

# ===== Desktop Update feed (optional — see docs/adr/0014) =====
# GET /api/desktop/update reads published GitHub Releases tagged desktop-v* and
# answers the Tauri updater. The defaults already point at this repo, so nothing
# here is required in production.
NUXT_DESKTOP_RELEASE_REPO=zabastx/voice-chat
# only raises the GitHub rate limit; the Releases list is public
NUXT_DESKTOP_GITHUB_TOKEN=
# minimum supported Desktop Release, returned in the X-Desktop-Minimum-Version
# header independently of the offered update. Raise only for a security issue
# or an incompatible protocol change; unset = nothing is required.
NUXT_DESKTOP_MINIMUM_VERSION=
# how long a successful catalog read is reused before GitHub is asked again
NUXT_DESKTOP_UPDATE_CACHE_SECONDS=300
# Development only — a production build ignores it and logs that it did. A
# fixture can name any URL and any signature, so it must never reach an
# installed client. Set = `bun run dev` reads that JSON catalog instead of
# GitHub (see test/fixtures/desktop-releases.json).
NUXT_DESKTOP_RELEASE_FIXTURE=

# ===== Local dev only (compose.dev.yaml) =====
# Your machine's LAN IP, used as LiveKit's --node-ip. Firefox blocks TURN
# allocations to 127.0.0.1, so for voice in Firefox set this to a non-loopback
# IP (Chrome works without it). Not used in production.
LIVEKIT_NODE_IP=

