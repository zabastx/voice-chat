{
	"name": "voice-chat",
	"version": "0.25.0",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "nuxt build",
		"dev": "nuxt dev --host",
		"desktop:dev": "bun scripts/desktop.ts dev",
		"desktop:compile": "bun scripts/desktop.ts compile",
		"desktop:build": "bun scripts/desktop.ts build",
		"desktop:run": "bun scripts/desktop.ts run",
		"desktop:check": "node desktop/tray-check.mjs",
